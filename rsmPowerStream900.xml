        <sounds>
            <hydraulic template="defaultHydraulicSound"/>
        </sounds>
    </cylindered>
	
	<connectionHoses>
        <hose inputAttacherJointIndices="1" type="electric"     node="0>12|3"       length="1.4" diameter="0.008" outgoingAdapter="DEFAULT" adapterType="NONE" socket="electric"/>
        <hose inputAttacherJointIndices="1" type="hydraulicIn"  node="0>12|0"  length="1.4" diameter="0.015" outgoingAdapter="DEFAULT" adapterType="NONE" socket="hydraulic01"/>
        <hose inputAttacherJointIndices="1" type="hydraulicOut" node="0>12|1" length="1.4" diameter="0.015" outgoingAdapter="DEFAULT" adapterType="NONE" socket="hydraulic01"/>
        <hose inputAttacherJointIndices="1" type="hydraulicIn"  node="0>12|2"  length="1.4" diameter="0.015" outgoingAdapter="DEFAULT" adapterType="NONE" socket="hydraulic01"/>

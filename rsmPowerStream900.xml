    <dynamicMount forceLimitScale="1"/>
	
	

	
	
    <washable dirtDuration="300" washDuration="1" workMultiplier="2"/>
	<wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
	
    <ai>
        <areaMarkers leftNode="0>4" rightNode="0>5" backNode="0>14"/>
        <sizeMarkers leftNode="0>15" rightNode="0>16" backNode="0>17"/>
		<collisionTrigger node="0>8" width="9.6" height="2.0"/>
		<agentAttachment width="10.0" height="2" length="3.2" lengthOffset="-0.3"/>

            <animationNode node="0>7|0" rotSpeed="800" rotAxis="1" turnOnFadeTime="1" turnOffFadeTime="1"/>
            <animationNode node="0>7|1|0|0|0" rotSpeed="200" rotAxis="1" turnOnFadeTime="1" turnOffFadeTime="1"/>
            <animationNode node="0>7|1|0|0|1" rotSpeed="200" rotAxis="1" turnOnFadeTime="1" turnOffFadeTime="1"/>
        </animationNodes>
		
		 <effect>

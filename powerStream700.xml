        </inputAttacherJoints>
    </attachable>

    <connectionHoses>
	  <hose inputAttacherJointIndices="1" type="hydraulicIn"  node="hydraulicIn01"  length="1.17" diameter="0.015" straighteningFactor="0.2" adapterType="NONE"/>

      <hose inputAttacherJointIndices="1" type="hydraulicIn" node="hydraulicIn02" length="1.17" diameter="0.015" straighteningFactor="0.2" adapterType="NONE"/>
	  
      <hose inputAttacherJointIndices="1" type="hydraulicOut" node="hydraulicIn03" length="1.17" diameter="0.015" straighteningFactor="0.2" adapterType="NONE"/>
	  <hose inputAttacherJointIndices="1" type="hydraulicIn" node="hydraulicOut03" length="1.17" diameter="0.015" straighteningFactor="0.2" adapterType="NONE"/>

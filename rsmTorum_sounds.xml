<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<sounds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/vehicle_sounds.xsd">
    <motorized>
        <sounds>
            <motor template="engineLarge" file="$data/vehicles/caseIH/axialFlow150/sounds/axialFlow150_loop.gls" volumeScale="1.4"/>
            <motor template="indoorCabinRumble" />
            <motor template="filterLoop" fadeIn="3" fadeOut="2" linkNode="0>17"/>
            <gearbox template="transmissionHarvester" pitchScale="0.9" volumeScale="1.0"/>
            <reverseDrive template="REVERSE_BEEP_01" />
        </sounds>
    </motorized>

    <lights>
        <sounds>
            <toggleLights template="SWITCH_01"  />
            <turnLight template="SWITCH_TURNLIGHT"  />
        </sounds>
    </lights>

    <attacherJoints>
        <sounds>
            <hydraulic template="defaultHydraulicHarvesters" linkNode="0>5|0|0|0"/>
        </sounds>
    </attacherJoints>

    <drivable>
        <sounds>
            <waterSplash template="WATER_SPLASH_01" />
        </sounds>
    </drivable>

    <turnOnVehicle>
        <sounds>
            <work template="harvesterChopper"  linkNode="0>"/>
        </sounds>
    </turnOnVehicle>

    <combine>
        <sounds>
            <chopStraw   template="chopStrawDischarge" linkNode="0>"/>
            <dropStraw   template="dropStrawDischarge" linkNode="0>"/>
            <fill template="grainTankFill" volumeScale="0.6" linkNode="0>"/>
        </sounds>
    </combine>

    <honk>
        <sound template="HONK_CASEIH_MAXXUM" />
    </honk>
</sounds>

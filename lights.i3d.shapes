<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="lights" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="8" filename="$data/shared/clearPlastic_diffuse.png"/>
    <File fileId="2" filename="rsmAcros595Lights_normal.dds"/>
    <File fileId="3" filename="rsmAcros595Lights_specular.dds"/>
  </Files>

  <Materials>
    <Material name="clearPlastic_mat" materialId="4" alphaBlending="true" customShaderId="4" customShaderVariation="staticLight">
      <Texture fileId="8"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <CustomParameter name="colorMat0" value="1 1 1 2"/>
      <CustomParameter name="colorMat1" value="1 0.25 0 2"/>
    </Material>
    <Material name="rsmAcros595Lights_mat" materialId="5" diffuseColor="0.494118 0.494118 0.494118 1" customShaderId="4" customShaderVariation="staticLight">
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <CustomParameter name="colorMat0" value="1 1 1 2"/>
      <CustomParameter name="colorMat1" value="1 0.25 0 2"/>
    </Material>
  </Materials>

  <Shapes externalShapesFile="lights.i3d.shapes">
  </Shapes>

  <Scene>
      <Shape shapeId="1" name="turnLight" clipDistance="35" nodeId="18" materialIds="5" castsShadows="true" receiveShadows="true">
        <Shape shapeId="2" name="innerPartStatic" clipDistance="75" nodeId="19" materialIds="5" castsShadows="true" receiveShadows="true"/>
        <Shape shapeId="3" name="glassStatic" clipDistance="75" nodeId="20" materialIds="4" castsShadows="true" receiveShadows="true" decalLayer="1"/>
      </Shape>
      <Shape shapeId="4" name="workingLightFront2" clipDistance="35" nodeId="21" materialIds="5" castsShadows="true" receiveShadows="true">
        <Shape shapeId="5" name="innerPartStatic2" clipDistance="75" nodeId="22" materialIds="5" castsShadows="true" receiveShadows="true"/>
        <Shape shapeId="6" name="glassStatic2" clipDistance="75" nodeId="23" materialIds="4" castsShadows="true" receiveShadows="true" decalLayer="1"/>
      </Shape>
      <Shape shapeId="7" name="workingLightTop3" rotation="-90 -0 0" clipDistance="35" nodeId="24" materialIds="5" castsShadows="true" receiveShadows="true">
        <Shape shapeId="8" name="innerPartStatic3" clipDistance="75" nodeId="25" materialIds="5" castsShadows="true" receiveShadows="true"/>
        <Shape shapeId="9" name="glassStatic3" clipDistance="75" nodeId="26" materialIds="4" castsShadows="true" receiveShadows="true" decalLayer="1"/>
      </Shape>
      <Shape shapeId="10" name="interiorLight" clipDistance="35" nodeId="27" materialIds="5" castsShadows="true" receiveShadows="true">
        <Shape shapeId="11" name="interiorWorkingLightStatic" clipDistance="75" nodeId="28" materialIds="4" castsShadows="true" receiveShadows="true" decalLayer="1"/>
      </Shape>
  </Scene>
</i3D>